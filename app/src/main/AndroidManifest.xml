<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- LOCAL-DEVIATION: reads Android's own local usage database to count today's screen time -
         see server.ScreenTimeTracker. Nothing leaves the device; this is the same source Digital
         Wellbeing and Samsung's screen-time UI read, so neither app has to be installed.

         Declaring it is necessary but not sufficient: PACKAGE_USAGE_STATS is an appop, and a
         Device Owner cannot grant it to itself (DevicePolicyManager has no path to it, and
         `pm grant` refuses non-runtime permissions). Grant it once per install over adb:

             adb shell appops set com.kidslauncher.mdm.debug android:get_usage_stats allow

         Note the package name: CI publishes the debug build, which carries
         applicationIdSuffix ".debug" - the command silently does nothing against the release id.
         It survives reboots but not a reinstall or `pm clear`. Without it every budget silently
         does not apply - deliberately the open direction, so a permission that quietly disappears
         costs enforcement rather than locking the kid out of every app at once. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- In-app "Scan setup QR" flow (SettingsFragmentLauncher, zxing-android-embedded) - Device
         Owner self-grants this the same way as other prompt-free permissions elsewhere in this
         file, so scanning never shows the runtime permission dialog. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Self-granted silently via DevicePolicyManager.setPermissionGrantState, required to call
         BluetoothAdapter.enable()/disable() from the Quick Controls screen on Android 12+. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Same self-grant pattern, required for BluetoothAdapter.startDiscovery() on Android 12+,
         used by the Quick Controls "manage devices" screen. neverForLocation for the same reason
         as NEARBY_WIFI_DEVICES below - we only need device identity, never physical position -
         and without it Android additionally requires the phone's system-wide Location toggle to
         be on before discovery returns any results at all, independent of this permission grant. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <!-- Normal-level, auto-granted at install - required to read/toggle WiFi state from the
         Quick Controls screen. Device Owner exempts us from the API 29+ restriction on WHO can
         toggle WiFi, but these are still required regardless of Device Owner status. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- Self-granted, required for WifiManager.startScan()/getScanResults() on Android 13+ -
         replaces the old ACCESS_FINE_LOCATION scanning requirement. neverForLocation since the
         Quick Controls "manage networks" screen only needs SSIDs, never physical position. -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Self-granted, for Find My Device's location trail (LocateCommands.kt). Plain
         android.location.LocationManager, never FusedLocationProviderClient - this project has no
         Google Play Services anywhere (GrapheneOS has none). ACCESS_BACKGROUND_LOCATION is needed
         since the read happens from MdmSyncWorker, a background job, not direct foreground user
         action - unconfirmed whether Device Owner can self-grant this one specifically, unlike
         every other permission in this app; see QuickControls/MdmSyncWorker for the diagnostic
         logging around it. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- CommandListenerService holds a long-lived SSE connection open so Find My Device's
         ring/lock/stop-ring/wipe commands arrive in ~1s instead of waiting for the next 2-minute
         poll, any time - screen on or off. Android mandates a specific foreground-service type +
         matching permission as of API 34; "dataSync" (syncing/sending/receiving data) is the
         correct fit for a long-lived server connection. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- LOCAL-DEVIATION: the sync that collects a location fix runs inside
         CommandListenerService, and on API 34 a backgrounded app only reaches LocationManager
         through a foreground service of type "location". With dataSync alone every provider
         returns null forever with nothing logged - which is exactly what happened here: zero rows
         in device_locations despite a `ring` command (which forces a fresh fix) being delivered
         and acknowledged. The nulls were previously read as a passive/active-fix problem; the real
         cause is one layer down.

         The service declares both types, but promotes itself to the location one only while the
         location permission is actually held - see CommandListenerService.foregroundServiceType().
         Declaring it unconditionally would make startForeground throw SecurityException on a
         device that has not self-granted location yet, and a foreground service that crashes in
         onCreate is a boot loop. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <application
        android:name=".Application"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/launcherBaseTheme"
        android:usesCleartextTraffic="true"
        tools:ignore="UnusedAttribute">

        <activity
            android:name=".ui.HomeActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/launcherHomeTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.list.AppListActivity"
            android:configChanges="orientation|screenSize"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:configChanges="orientation|screenSize"
            android:exported="true"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.LegalInfoActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ReportCrashActivity"
            android:exported="false" />
        <activity
            android:name=".ui.LockActivity"
            android:excludeFromRecents="true"
            android:exported="false" />
        <activity
            android:name=".ui.quickcontrols.QuickControlsActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false" />
        <activity
            android:name=".ui.quickcontrols.WifiNetworksActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.quickcontrols.BluetoothDevicesActivity"
            android:configChanges="orientation|screenSize"
            android:exported="false" />

        <receiver
            android:name=".server.MdmDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Not externally reachable - only ever triggered via the PendingIntent passed to
             PackageInstaller.Session.commit() in AppInstaller.kt, for every tracked app's
             install/update, including the launcher's own self-update. -->
        <receiver
            android:name=".server.AppInstallReceiver"
            android:exported="false" />

        <!-- Not externally reachable - only ever triggered via the PendingIntent passed to
             PackageInstaller.uninstall() in AppInstaller.kt. -->
        <receiver
            android:name=".server.AppUninstallReceiver"
            android:exported="false" />

        <!-- Not externally reachable - only ever triggered via the "Stop Ringing" action's own
             PendingIntent on the notification LocateCommands.ring() shows. -->
        <receiver
            android:name=".server.StopRingReceiver"
            android:exported="false" />

        <!-- Deliberately exported, unlike every other receiver in this app - see
             UnifiedPushRegistrationReceiver's own doc comment for why. Other apps' UnifiedPush
             connector libraries send these two actions as implicit broadcasts to discover an
             installed distributor; there's no component name they could target instead.
             android:enabled="false" here matches the spec's own recommendation to keep a
             distributor's registration receiver disabled until its setup precondition is met -
             here, that's a parent opting in from Settings, which flips this at runtime via
             PackageManager.setComponentEnabledSetting (see SettingsFragmentLauncher). Until then
             this app isn't even discoverable as a distributor, not just non-functional. -->
        <receiver
            android:name=".server.UnifiedPushRegistrationReceiver"
            android:exported="true"
            android:enabled="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.distributor.REGISTER" />
                <action android:name="org.unifiedpush.android.distributor.UNREGISTER" />
                <action android:name="org.unifiedpush.android.distributor.MESSAGE_ACK" />
            </intent-filter>
        </receiver>

        <service
            android:name=".server.CommandListenerService"
            android:exported="false"
            android:foregroundServiceType="dataSync|location" />

        <!-- Not externally reachable despite the implicit-action intent-filter - MY_PACKAGE_REPLACED
             is a protected system broadcast only the OS can send, always targeted at the just-updated
             app itself. See PackageReplacedReceiver's own doc comment for why this exists. -->
        <receiver
            android:name=".server.PackageReplacedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>